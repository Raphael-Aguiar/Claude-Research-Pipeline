# API Keys — Pipeline de Pesquisa Acadêmica
# Copie para .env e preencha com seus dados.
# Nenhuma key é obrigatória para o MVP (PubMed e OpenAlex aceitam email como identificação).

# NCBI/PubMed — registrar em https://www.ncbi.nlm.nih.gov/account/
# Obrigatório para E-utilities. Sem key: limite de 3 req/s. Com key: 10 req/s.
NCBI_EMAIL=seu@email.com
NCBI_API_KEY=

# OpenAlex — polite pool: basta informar email
# https://docs.openalex.org/how-to-use-the-api/rate-limits-and-authentication
OPENALEX_EMAIL=seu@email.com

# CrossRef — polite pool: basta informar email
# https://www.crossref.org/documentation/retrieve-metadata/rest-api/tips-for-using-the-metadata-api/
CROSSREF_EMAIL=seu@email.com

# Unpaywall — requer email para identificação
# https://unpaywall.org/products/api
UNPAYWALL_EMAIL=seu@email.com

# Semantic Scholar — API key opcional (maior rate limit)
# https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# BVS/BIREME — busca federada LILACS + SciELO + MEDLINE
# Chave GRATUITA: solicitar em https://api.bvsalud.org
# Sem chave, a base bvs_lilacs fica indisponível (portal público tem anti-robô).
BVS_API_KEY=
